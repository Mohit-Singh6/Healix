// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id            String     @id @default(cuid())
  name          String
  repoOwner     String     // ex: "octocat"
  repoName      String     // ex: "backend-api"
  deployedUrl   String?
  apiKey        String     @unique @default(uuid()) // Authenticates incoming alert webhooks
  userId        String
  user          User       @relation("UserProjects", fields: [userId], references: [id], onDelete: Cascade)
  incidents     Incident[]
  errorLogs     ErrorLog[]
  createdAt     DateTime   @default(now())
}

enum IncidentStatus {
  INVESTIGATING
  PENDING_APPROVAL
  MITIGATING
  RESOLVED
  DISMISSED
}

enum IncidentSeverity {
  SEV1
  SEV2
  SEV3
}

model Incident {
  id              String           @id @default(cuid())
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  status          IncidentStatus   @default(INVESTIGATING)
  severity        IncidentSeverity @default(SEV2)
  threadId        String?          @unique // Maps directly to LangGraph checkpoint state

  // Agent Investigation & Mitigation Data
  rootCause       String?          @db.Text
  proposedAction  String?          // e.g., "REVERT_COMMIT"
  targetCommitSha String?          // Commit SHA identified by the agent
  revertPrUrl     String?          // GitHub PR URL opened by the agent

  // Relations
  logs            ErrorLog[]
  postMortem      PostMortem?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([projectId, status])
}

model ErrorLog {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  incidentId  String?   // Nullable initially; populated upon triage/deduplication
  incident    Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  statusCode  Int?
  serviceName String    @default("default") // Distinguishes auth-api from checkout-worker
  message     String
  stackTrace  String    @db.Text
  endpoint    String?   // (Your 'url')

  // 768 dimensions matches Gemini text-embedding-004
  embedding   Unsupported("vector(768)")?

  createdAt   DateTime  @default(now())

  @@index([projectId, createdAt])
}

model PostMortem {
  id              String    @id @default(cuid())
  incidentId      String    @unique
  incident        Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  summary         String    @db.Text // Brief executive summary
  rootCause       String    @db.Text // Technical breakdown of why it failed
  mitigationSteps String    @db.Text // What code/config fixed it
  preventativeRecs Json?    // Array of action items to prevent recurrence
  fullMarkdown    String    @db.Text // Rendered in your Phase 5 dashboard

  mttdSeconds     Int?      // Time from first error log to incident trigger
  mttrSeconds     Int?      // Time from alert to final mitigation
  createdAt       DateTime  @default(now())
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  projects      Project[] @relation("UserProjects")
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}