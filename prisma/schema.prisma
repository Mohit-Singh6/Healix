// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DeploymentProvider {
  VERCEL
  RENDER
  CUSTOM
  NONE
}

model Project {
  id                   String             @id @default(cuid())
  name                 String
  repoOwner            String             // ex: "octocat"
  repoName             String             // ex: "backend-api"
  defaultBranch        String             @default("main")
  deployedUrl          String?
  apiKey               String             @unique @default(uuid()) // Authenticates incoming alert webhooks

  // GitHub Access Configuration
  githubToken          String?            // Fine-grained PAT scoped to repo (Contents: RW, PRs: RW)
  githubInstallationId String?            // Used if authenticated via GitHub App

  // Cloud Platform Remediation Config (APPLY_CONFIG_PATCH)
  deploymentProvider   DeploymentProvider @default(NONE)
  platformServiceId    String?            // Render Service ID or Vercel Project ID
  platformApiToken     String?            // API key/token with permission to update env vars
  platformTeamId       String?            // Vercel Team ID (optional, for team-scoped Vercel projects)
  customWebhookUrl     String?            // Webhook endpoint called when deploymentProvider is CUSTOM

  userId               String
  user                 User               @relation("UserProjects", fields: [userId], references: [id], onDelete: Cascade)
  incidents            Incident[]
  errorLogs            ErrorLog[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

enum IncidentStatus {
  INVESTIGATING
  PENDING_APPROVAL
  MITIGATING
  RESOLVED
  DISMISSED
}

enum IncidentSeverity {
  SEV1
  SEV2
  SEV3
}

enum HumanApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Incident {
  id                  String               @id @default(cuid())
  projectId           String
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title               String
  serviceName         String               @default("default")
  errorMessage        String?              @db.Text
  stackTrace          String?              @db.Text
  status              IncidentStatus       @default(INVESTIGATING)
  severity            IncidentSeverity     @default(SEV2)
  threadId            String?              @unique // Maps directly to LangGraph checkpoint state

  // Agent Investigation & Mitigation Data
  rootCause           String?              @db.Text
  proposedAction      String?              // "REVERT_PR" | "BUGFIX_PR" | "APPLY_CONFIG_PATCH" | "MANUAL_INTERVENTION" | "NO_ACTION"
  actionPayload       Json?                // Stores targetFilePath, patchMode, replacements, configKey, configValue, etc.
  targetCommitSha     String?              // Culprit commit SHA identified by the agent
  revertPrUrl         String?              // Backward compatibility field
  remediationPrUrl    String?              // GitHub PR URL opened by the agent (for both REVERT_PR and BUGFIX_PR)

  // Human-in-the-Loop (HITL) Gate Audit Trail
  humanApprovalStatus HumanApprovalStatus  @default(PENDING)
  operatorFeedback    String?              @db.Text
  reviewedBy          String?              // Operator name or email
  decidedAt           DateTime?

  // Relations
  logs                ErrorLog[]
  postMortem          PostMortem?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([projectId, status])
}

model ErrorLog {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  incidentId  String?   // Nullable initially; populated upon triage/deduplication
  incident    Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  statusCode  Int?
  serviceName String    @default("default") // Distinguishes auth-api from checkout-worker
  message     String
  stackTrace  String    @db.Text
  endpoint    String?   // URL or route where error occurred

  // 768 dimensions matches Gemini text-embedding-004
  embedding   Unsupported("vector(768)")?

  createdAt   DateTime  @default(now())

  @@index([projectId, createdAt])
}

model PostMortem {
  id               String    @id @default(cuid())
  incidentId       String    @unique
  incident         Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  title            String    @default("Incident Post-Mortem Report")
  summary          String    @db.Text // Brief executive summary
  rootCause        String    @db.Text // Technical breakdown of why it failed
  mitigationSteps  String    @db.Text // What code/config fixed it
  preventativeRecs Json?     // Array of action items to prevent recurrence
  fullMarkdown     String    @db.Text // Rendered in dashboard

  mttdSeconds      Int?      // Time from first error log to incident trigger
  mttrSeconds      Int?      // Time from alert to final mitigation
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  projects      Project[] @relation("UserProjects")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}